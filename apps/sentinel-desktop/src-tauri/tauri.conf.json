{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AIOM Sentinel",
  "version": "0.1.0",
  "identifier": "com.aiom.sentinel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "AIOM Sentinel",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../resources/rules/sentinel-default.rules": "rules/sentinel-default.rules",
      "../resources/rules/sentinel-default.rules.sha256": "rules/sentinel-default.rules.sha256"
      ,"../resources/rules/sentinel-default.yar": "rules/sentinel-default.yar"
      ,"../resources/rules/sentinel-default.yar.sha256": "rules/sentinel-default.yar.sha256"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
